# Copy to .env — `npm start` loads it automatically.

# ---- server ----
PORT=8787
# Requests slower than this are logged with their path, so "it takes forever"
# becomes attributable.
SLOW_REQUEST_MS=2000
HOST=0.0.0.0
LOG_LEVEL=info
# Extra browser origins allowed to call the API (comma separated).
# localhost is always allowed; requests with no Origin header are too.
CORS_ORIGINS=

# ---- model brain (OpenAI-compatible) ----
# With these set, the UI can point its BASE URL at http://localhost:8787/api/v1
# and hold no API key of its own.
# BRAIN_BASE=https://openrouter.ai/api/v1
# BRAIN_BASE=https://api.openai.com/v1
# BRAIN_BASE=https://api.groq.com/openai/v1
# BRAIN_BASE=http://localhost:11434/v1        # Ollama, no key needed
BRAIN_BASE=
BRAIN_KEY=
BRAIN_MODEL=gpt-4o-mini
BRAIN_TIMEOUT_MS=120000
# How long speech waits on the model before saying the plainer rules version
# instead. Silence while a brief is written is worse than a plainer brief.
# This one applies once there is already audio — a lead sentence being spoken.
VOICE_DEADLINE_MS=2500
# The same budget while nothing is being said, and much tighter, because a
# streamed brief only has to produce its first sentence to start speaking.
VOICE_FIRST_SENTENCE_MS=700
# Upstream ceiling for model calls made while somebody is mid-utterance —
# spoken briefs and intent translation. Separate from BRAIN_TIMEOUT_MS because
# two minutes is reasonable for a dossier being written to a screen and absurd
# for a person standing at a microphone. On a streamed brief this bounds
# silence, not the call: it is re-armed on every chunk, so a model that keeps
# writing is never cut off mid-brief.
VOICE_BRAIN_TIMEOUT_MS=8000

# ---- speech, synthesised on the server ----
# Unset means the desk speaks through the browser's own synthesiser, which is
# free and instant — and produces nothing at all on a machine with no voices
# installed, silently and with no client-side remedy. Point this at a service
# that returns audio and that failure disappears: the browser only has to play
# a sound, which it can always do.
#
# `services/omnivoice` in this repo is one such service. It needs a GPU; see its
# README. Any backend answering GET /health and POST /speak -> audio/wav works.
TTS_BASE=
TTS_KEY=
# Voice design attributes, for backends that support them.
TTS_INSTRUCT=
# A saved voice-clone prompt on the service, if it has one.
TTS_VOICE=
# Past this the desk stops waiting and reads it in the browser's voice instead.
TTS_TIMEOUT_MS=12000
TTS_MAX_BYTES=8388608

# ---- alerts ----
# Slack/Discord incoming webhook. Without it, notify actions are logged only.
NOTIFY_WEBHOOK=
# Allow callers to pass their own webhook in the request body (relay risk).
NOTIFY_ALLOW_REQUEST_WEBHOOK=false
# Rewrite alerts into one readable line before sending. An alert is read on a
# phone, away from a screen, so a metric dump is wasted there.
NOTIFY_VOICE=true

# ---- access control ----
# Unset means open, which is fine on loopback and nowhere else: anyone who can
# reach the port can arm goals, read memory and spend the model budget.
# Set it, then open the desk once as http://host:8787/?token=YOUR_TOKEN — the
# token is exchanged for an httpOnly cookie and stripped from the URL.
API_TOKEN=
API_TOKEN_COOKIE_MAX_AGE=2592000
# The desk's settings panel calls this same secret PROXY_TOKEN, so that name is
# accepted too. Set one or the other — API_TOKEN wins if both are present.
PROXY_TOKEN=

# ---- voice booking (off unless all three are set) ----
# Placing automated calls is regulated differently depending on where the
# caller and the callee are, so this stays off until it is switched on
# deliberately. Until then /api/book answers 501 with a call script the
# operator can dial by hand.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- deep research fetcher ----
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2097152
FETCH_MAX_TEXT_CHARS=20000
# Leave false in any shared deployment — true lets /api/fetch reach private
# addresses (SSRF).
ALLOW_PRIVATE_EGRESS=false

# ---- market data ----
# Point at a mirror or a replay when Yahoo is unreachable or being stubbed.
YAHOO_BASE=https://query1.finance.yahoo.com
YAHOO_CHART_RANGE=2y
YAHOO_CHART_INTERVAL=1d
MARKET_CACHE_MS=60000
# A quote sits on the critical path of a question someone is waiting on, so it
# gets a much shorter timeout than the generic fetcher.
MARKET_TIMEOUT_MS=6000
# Ceiling for the whole quote fallback ladder, so one call cannot stack three
# timeouts back to back.
MARKET_QUOTE_BUDGET_MS=9000
# How long a symbol that just failed is answered fast rather than re-walking
# the same dead endpoints.
MARKET_FAILURE_TTL_MS=30000
# Consecutive failures before the feed is treated as down and every symbol
# fails fast until it recovers.
MARKET_BREAKER_THRESHOLD=2
MARKET_BREAKER_MS=30000
# Keep watchlist and portfolio symbols warm so the first dossier is not the
# slow one. 0 disables.
MARKET_WARM_MS=300000

# ---- email ----
# Resend needs no dependency, so it is the path that always works.
RESEND_API_KEY=
EMAIL_FROM=SurfingAlien <onboarding@resend.dev>
EMAIL_TO=
# Overridable for a relay, a self-hosted gateway, or a test stub.
RESEND_ENDPOINT=https://api.resend.com/emails
# SMTP is the fallback and needs `npm install nodemailer`.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- analysis ----
# Framing for written analysis: neutral | buffett | burry | wood | marks | lynch
# It shapes emphasis and never the figures.
ANALYSIS_PERSONA=neutral
# Half Kelly, capped at 20% of the portfolio. Sizes are advisory only.
KELLY_FRACTION=0.5
KELLY_MAX_FRACTION=0.2
# Resolved calls needed before a measured win rate is trusted over the default.
KELLY_MIN_SAMPLES=15

# ---- prediction ledger ----
# Append-only, so a scorecard can always be recomputed from the raw record.
PREDICTIONS_FILE=data/predictions.jsonl
# Log every actionable call a scan produces, so it can be scored later.
PREDICTIONS_LOG_SIGNALS=true

# ---- autonomy loop ----
AUTONOMY_ENABLED=true
AUTONOMY_TICK_MS=30000
AUTONOMY_MAX_ACTIVITY=200
STATE_FILE=data/state.json

# ---- rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
