# Copy to proxy/.env and edit. Never commit the real file.

PORT=8787

# --- model provider (any OpenAI-compatible /chat/completions) ---
# OpenAI      https://api.openai.com/v1          gpt-4o-mini
# OpenRouter  https://openrouter.ai/api/v1       openai/gpt-4o-mini
# Groq        https://api.groq.com/openai/v1     llama-3.3-70b-versatile
# Ollama      http://host.docker.internal:11434/v1   llama3.1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Blank OPENAI_API_KEY = offline brain: memory, tasks, reminders and compute all
# still work through the tools; only free-form model answers are unavailable.

# --- storage ---
DATA_DIR=./data

# --- the door -------------------------------------------------------------
# open     : API_TOKEN blank and no users  -> ONE shared "anon" tenant, no auth.
#            Fine on a laptop. It is not multi-user; lock it before exposing it.
# token    : API_TOKEN set -> the "service" tenant. One shared brain for machines.
# session  : users provisioned -> one isolated brain per person. Use this for people.
API_TOKEN=
ADMIN_USER=
ADMIN_PASS=
SESSION_TTL_MIN=720

# Generate a token:  openssl rand -base64 32
# ADMIN_USER/ADMIN_PASS seed data/users.json on first boot only, and the password
# is hashed on the way in. Rotate it out via POST /api/users afterwards.

# --- network ---
# Behind nginx/Caddy, set this so rate limiting sees real client IPs.
TRUST_PROXY=0
# Tighten for production, e.g. ALLOWED_ORIGINS=https://deck.example.com
ALLOWED_ORIGINS=*

# --- limits ---
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
AGENT_MAX_TURNS=8
UPSTREAM_TIMEOUT_MS=60000
MAX_TENANTS_CACHED=500

# --- opt-in behaviour -----------------------------------------------------
# Hands the server's model key to any authenticated caller. Leave off unless
# you actually need a raw OpenAI-compatible endpoint.
ENABLE_RAW_PASSTHROUGH=0
# Delete a user's brain directory when the user is deleted.
PURGE_BRAIN_ON_USER_DELETE=0
