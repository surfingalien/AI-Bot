<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.surfingalien.proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PREFIX__/server.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>SURFINGALIEN_ENV_FILE</key>
    <string>__ENV_FILE__</string>
    <key>DATA_DIR</key>
    <string>__DATA_DIR__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__PREFIX__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on a crash, but not when it exits cleanly on SIGTERM. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/surfingalien.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/surfingalien.err.log</string>
</dict>
</plist>
